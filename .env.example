# Backend server bind (keep loopback; expose via Caddy/OpenWRT)
HOST=127.0.0.1
PORT=8080

# LAN-only allow list (CIDRs)
ALLOW_CIDRS=192.168.0.0/16,10.0.0.0/8

# Optional admin token for write operations
ADMIN_TOKEN=changeme

# Server registry and lifecycle
REGISTRY_FILE=/opt/mc-lxd-manager/servers.json
SERVER_ARCHIVES_FILE=/opt/mc-lxd-manager/server-archives.json
MAX_ACTIVE_SERVERS=3
# SERVER_LIFECYCLE_COMMAND=/opt/mc-lxd-manager/apps/scripts/mc-server-lifecycle.mjs
# SERVER_LIFECYCLE_USE_SUDO=false

# Backup directory
BACKUP_DIR=/var/backups/mc-lxd-manager
